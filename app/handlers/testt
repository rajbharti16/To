import io
import time

from aiogram import F, Router
from aiogram.types import BufferedInputFile, CallbackQuery

from app import db, keyboards as kb
from app.handlers.menu import show
from app.utils.texts import stats_text

router = Router()


@router.callback_query(F.data == "m:stats")
async def cb_stats(cq: CallbackQuery):
    await show(cq, stats_text(await db.ledger_stats(cq.from_user.id)), kb.back())
    await cq.answer()


@router.callback_query(F.data == "m:ledger")
async def cb_ledger(cq: CallbackQuery):
    rows = await db.ledger_rows(cq.from_user.id)
    if not rows:
        return await show(cq, "ledger empty", kb.back())
    buf = io.StringIO()
    buf.write("purchase_id,item_id,buy,sell,status,created,closed\n")
    for r in rows:
        buf.write(f"{r['purchase_id']},{r['item_id']},{r['buy_price']},"
                  f"{r['sell_price']},{r['status']},{r['created_at']},{r['closed_at']}\n")
    await cq.message.answer_document(
        BufferedInputFile(buf.getvalue().encode(), filename=f"ledger_{int(time.time())}.csv"))
    await cq.answer()


app/handlers/admin.py

from aiogram import Router
from aiogram.filters import Command
from aiogram.types import Message

from app import db
from app.config import OWNER_IDS

router = Router()


@router.message(Command("addowner"))
async def cmd_addowner(m: Message):
    if OWNER_IDS and m.from_user.id not in OWNER_IDS:
        return
    parts = (m.text or "").split()
    if len(parts) < 2 or not parts[1].isdigit():
        return await m.answer("Usage: /addowner 123456789")
    await db.ensure_user(int(parts[1]))
    await m.answer(f"✅ Added {parts[1]}")


@router.message(Command("sold"))
async def cmd_sold(m: Message):
    parts = (m.text or "").split()
    if len(parts) < 3:
        return await m.answer("Usage: /sold <purchase_id> <price>")
    try:
        await db.mark_sold(parts[1], float(parts[2]))
    except ValueError:
        return await m.answer("❌ Price must be a number")
    await m.answer(f"✅ Marked sold for ${parts[2]}")